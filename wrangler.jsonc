{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "election-night",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Shared Senate/House seat tally (one tiny Durable Object; works on the free plan).
  "durable_objects": {
    "bindings": [{ "name": "TALLY", "class_name": "Tally" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tally"] }],
  "observability": { "enabled": true }
}
